{
  "domain": "banking",
  "version": 1,
  "description": "Risk-based personal loan interest-rate pricing: credit score tier, LTV, DTI, term, segment, delinquency, collateral.",
  "currency": "APR_PCT",
  "entity": {"name": "loan_quote", "description": "Annual percentage rate quoted for one loan offer"},
  "attributes": [
    {"name": "base_rate", "type": "number", "description": "Benchmark/prime rate before risk adjustments"},
    {"name": "credit_score", "type": "number", "description": "FICO-style credit score, 300-850"},
    {"name": "loan_to_value_ratio", "type": "number", "description": "Loan amount / collateral value"},
    {"name": "debt_to_income_ratio", "type": "number", "description": "Borrower's total debt / income"},
    {"name": "loan_term_months", "type": "number"},
    {"name": "customer_segment", "type": "string", "enum": ["retail", "existing_customer", "private_banking"]},
    {"name": "collateral_type", "type": "string", "enum": ["unsecured", "secured"]},
    {"name": "delinquency_history_count", "type": "number", "description": "Number of past delinquencies on record"}
  ],
  "base_price": {"mode": "attribute", "attribute": "base_rate"},
  "combination_mode": "sequential",
  "rules": [
    {
      "id": "credit_tier_subprime",
      "description": "Subprime credit score risk premium",
      "priority": 10,
      "condition": {"attr": "credit_score", "op": "between", "value": [300, 579]},
      "adjustment": {"type": "add", "value": 4.0},
      "tags": ["risk", "credit"]
    },
    {
      "id": "credit_tier_subpar",
      "description": "Subpar credit score risk premium",
      "priority": 11,
      "condition": {"attr": "credit_score", "op": "between", "value": [580, 669]},
      "adjustment": {"type": "add", "value": 2.0},
      "tags": ["risk", "credit"]
    },
    {
      "id": "credit_tier_fair",
      "description": "Fair credit score small risk premium",
      "priority": 12,
      "condition": {"attr": "credit_score", "op": "between", "value": [670, 739]},
      "adjustment": {"type": "add", "value": 0.75},
      "tags": ["risk", "credit"]
    },
    {
      "id": "credit_tier_prime_discount",
      "description": "Prime credit score discount",
      "priority": 13,
      "condition": {"attr": "credit_score", "op": "between", "value": [740, 850]},
      "adjustment": {"type": "add", "value": -0.25},
      "tags": ["risk", "credit"]
    },
    {
      "id": "high_ltv_addon",
      "description": "Loan-to-value above 90% risk add-on",
      "priority": 20,
      "condition": {"attr": "loan_to_value_ratio", "op": ">", "value": 0.9},
      "adjustment": {"type": "add", "value": 0.5},
      "tags": ["risk", "collateral"]
    },
    {
      "id": "high_dti_addon",
      "description": "Debt-to-income above 43% risk add-on",
      "priority": 21,
      "condition": {"attr": "debt_to_income_ratio", "op": ">", "value": 0.43},
      "adjustment": {"type": "add", "value": 0.75},
      "tags": ["risk", "affordability"]
    },
    {
      "id": "long_term_premium",
      "description": "Premium for terms of 30 years (360 months) or more",
      "priority": 30,
      "condition": {"attr": "loan_term_months", "op": ">=", "value": 360},
      "adjustment": {"type": "add", "value": 0.25},
      "tags": ["term"]
    },
    {
      "id": "existing_customer_discount",
      "description": "Relationship discount for existing customers",
      "priority": 40,
      "condition": {"attr": "customer_segment", "op": "==", "value": "existing_customer"},
      "adjustment": {"type": "add", "value": -0.25},
      "tags": ["segment"]
    },
    {
      "id": "private_banking_discount",
      "description": "Private banking relationship discount",
      "priority": 40,
      "condition": {"attr": "customer_segment", "op": "==", "value": "private_banking"},
      "adjustment": {"type": "add", "value": -0.5},
      "tags": ["segment"]
    },
    {
      "id": "delinquency_penalty",
      "description": "Risk penalty scaled by number of past delinquencies",
      "priority": 50,
      "condition": {"attr": "delinquency_history_count", "op": ">=", "value": 1},
      "adjustment": {"type": "formula", "formula": "price + delinquency_history_count * 0.5"},
      "tags": ["risk", "history"]
    },
    {
      "id": "collateral_secured_discount",
      "description": "Discount when the loan is secured by collateral",
      "priority": 60,
      "condition": {"attr": "collateral_type", "op": "==", "value": "secured"},
      "adjustment": {"type": "add", "value": -0.3},
      "tags": ["collateral"]
    }
  ],
  "constraints": [
    {"type": "min_price", "value": 2.0},
    {"type": "max_price", "value": 29.99},
    {"type": "round", "value": 0.125, "rounding": "nearest"}
  ]
}
